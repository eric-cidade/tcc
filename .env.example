# Copie para .env e ajuste. Formato CHAVE=valor, sem espaços em volta do '=' e
# sem aspas: em produção este arquivo é lido também pelo systemd
# (EnvironmentFile), que não tolera as folgas que o python-dotenv aceita.

# --- Meilisearch (busca léxica) ---
# Obrigatória: sem ela a indexação e a busca abortam.
MEILI_MASTER_KEY=sua_chave_aqui
# Use 127.0.0.1, NÃO 'localhost': o Meilisearch escuta só em IPv4 e o cliente
# tenta ::1 primeiro, esperando o timeout — 2,03s por consulta contra 0,009s.
MEILI_URL=http://127.0.0.1:7700

# --- Modelo de embedding (busca semântica) ---
# EMBED_MODEL e CHROMA_COLLECTION PRECISAM casar: cada modelo tem dimensão e
# escala de score próprias, por isso cada um tem a sua coleção. Trocar o modelo
# exige reindexar (uv run python embedding.py) na coleção correspondente.
# Modelos suportados e seus limiares medidos estão em modelos.py (MODELOS).
#
# Vazio = o default de modelos.py (bge-m3, licença MIT). Alternativa mais leve e
# rápida, porém com repositório gated e obrigações da licença Gemma no site:
#   EMBED_MODEL=google/embeddinggemma-300m
#   CHROMA_COLLECTION=corpop_saude_gemma_estr
EMBED_MODEL=
CHROMA_COLLECTION=

# Lote do encode na indexação. Principal controle de pico de RAM: num servidor
# pequeno (4GB, sem GPU) use 8; vazio/0 mantém o default do sentence-transformers.
EMBED_BATCH=

# Token da HuggingFace. NÃO é necessário com o modelo padrão (bge-m3, MIT).
# Só faz falta para repositórios gated — o google/embeddinggemma-300m exige
# aceitar a licença Gemma antes de baixar, e sem o token o serviço não sobe.
# Gere em huggingface.co/settings/tokens com permissão de leitura.
HF_TOKEN=

# URL da API para o indexador pedir os embeddings (endpoint /embed), evitando
# carregar uma segunda cópia do modelo. Vazio força o modelo local.
EMBED_API=http://127.0.0.1:8000

# --- Caminhos ---
# Onde fica o índice vetorial. Vazio = ./chroma_db ao lado do código.
CHROMA_PATH=

# --- API ---
# Origens liberadas no CORS, separadas por vírgula. Vazio = sem CORS, que é o
# caso de produção (nginx serve o front e a API na mesma origem). Em dev, se
# servir o front por outra porta, coloque a origem aqui:
#   CORS_ORIGINS=http://localhost:5500
CORS_ORIGINS=
